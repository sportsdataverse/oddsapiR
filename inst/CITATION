## Citation year is PINNED to the first-release year (CRAN 2022-06-22).
## DESCRIPTION has no Date field, so deriving it from meta$Date yielded an
## empty year, and a current-date fallback made the same package version
## cite as a different year every calendar year. Keep this in sync with the
## bibtex block in README.md.
year <- 2026
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype  = "Misc",
  header   = "To cite the oddsapiR R package in publications, use:",
  key      = "gilani_oddsapiR",
  author   = c(person("Saiem", "Gilani", comment = c(ORCID = "0000-0002-7194-9067"))),
  title    = "oddsapiR: The SportsDataverse's R Package for The Odds API.",
  url      = "https://oddsapiR.sportsdataverse.org",
  doi      = "10.32614/CRAN.package.oddsapiR",
  year     = year,
  note     = note,
  textVersion = paste0(
    "Saiem Gilani (", year, "). oddsapiR: The SportsDataverse's R Package for ",
    "The Odds API. ", note, ". Retrieved from https://oddsapiR.sportsdataverse.org"
  )
)
